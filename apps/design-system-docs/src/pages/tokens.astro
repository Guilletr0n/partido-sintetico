---
import ShowcaseLayout from '../layouts/ShowcaseLayout.astro';
import { tokens } from '@repo/design-system/tokens';

const colorEntries = Object.entries(tokens.colors);
const typographyEntries = Object.entries(tokens.typography.sizes);
const radiiEntries = Object.entries(tokens.radii);
const spacingEntries = Object.entries(tokens.spacing);
---

<ShowcaseLayout title="Design Tokens Explorer">
  <div class="max-w-5xl space-y-10">
    <div>
      <h1 class="text-3xl font-extrabold text-white">Design Tokens Explorer</h1>
      <p class="text-slate-400 mt-2">Visual specifications defined in <code class="text-blue-400 font-mono">packages/design-system/src/tokens/index.ts</code>.</p>
    </div>

    <!-- Color Palette Swatches -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-white border-b border-slate-800 pb-2">Color Tokens</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {colorEntries.map(([key, hex]) => (
          <div class="bg-slate-800 border border-slate-700 rounded-xl overflow-hidden p-3 space-y-3">
            <div class="h-16 rounded-lg shadow-inner border border-slate-900/40" style={`background-color: ${hex}`}></div>
            <div>
              <div class="font-mono text-sm font-bold text-white">{key}</div>
              <div class="font-mono text-xs text-slate-400 uppercase">{hex}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Typography Scale -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-white border-b border-slate-800 pb-2">Typography Scale</h2>
      <div class="bg-slate-800 border border-slate-700 rounded-xl divide-y divide-slate-700">
        {typographyEntries.map(([sizeKey, sizeVal]) => (
          <div class="p-4 flex items-center justify-between">
            <div class="w-32">
              <span class="font-mono text-xs text-blue-400 font-bold">{sizeKey}</span>
              <span class="font-mono text-xs text-slate-400 ml-2">({sizeVal})</span>
            </div>
            <div class="flex-grow font-sans text-white truncate" style={`font-size: ${sizeVal}`}>
              Partido Sintético Español — Inteligencia Colectiva
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Spacing Scale Grid -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-white border-b border-slate-800 pb-2">Spacing Scale Tokens</h2>
      <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 grid grid-cols-2 sm:grid-cols-4 gap-6">
        {spacingEntries.map(([key, val]) => (
          <div class="space-y-2">
            <div class="flex justify-between items-center text-xs font-mono">
              <span class="text-blue-400 font-bold">spacing.{key}</span>
              <span class="text-slate-400">{val}</span>
            </div>
            <div class="bg-blue-600/30 border border-blue-500 rounded h-4" style={`width: ${val}`}></div>
          </div>
        ))}
      </div>
    </section>

    <!-- Radii Tokens -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-white border-b border-slate-800 pb-2">Border Radius Tokens</h2>
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
        {radiiEntries.map(([key, val]) => (
          <div class="bg-slate-800 border border-slate-700 p-4 text-center space-y-3">
            <div class="w-16 h-16 bg-blue-600 mx-auto" style={`border-radius: ${val}`}></div>
            <div>
              <div class="font-mono text-xs font-bold text-white">{key}</div>
              <div class="font-mono text-xs text-slate-400">{val}</div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</ShowcaseLayout>
