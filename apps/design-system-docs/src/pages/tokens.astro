---
import ShowcaseLayout from '../layouts/ShowcaseLayout.astro';
import { tokens } from '@repo/design-system/tokens';
import logoImage from '../../sources/images/logo-128x64-bg-black.png';

const colorEntries = Object.entries(tokens.colors);
const typographyEntries = Object.entries(tokens.typography.sizes);
const radiiEntries = Object.entries(tokens.radii);
const spacingEntries = Object.entries(tokens.spacing);
const shadowEntries = Object.entries(tokens.shadows);
---

<ShowcaseLayout title="Design Tokens Explorer">
  <div class="max-w-5xl space-y-12">
    <div class="border-b-2 border-zinc-800 pb-6">
      <div class="flex items-center space-x-2 mb-2">
        <span class="w-3 h-3 bg-[#ff2d2d]"></span>
        <span class="font-mono text-xs font-bold text-[#ff2d2d] uppercase tracking-widest">// ESPECIFICACIONES TÉCNICAS</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-black uppercase text-white tracking-tight">Design Tokens Explorer</h1>
      <p class="text-zinc-400 mt-2 font-mono text-xs">
        Defined in <code class="text-[#ff2d2d] font-mono">packages/design-system/src/tokens/index.ts</code>
      </p>
    </div>

    <!-- Brand Assets (Logo) -->
    <section class="space-y-4">
      <h2 class="text-xl font-black uppercase text-white tracking-tight border-b-2 border-zinc-800 pb-2">
        // 01 · Brand Identity Assets (Logo)
      </h2>
      <div class="bg-[#0d0d0d] border-2 border-zinc-800 p-6 space-y-6">
        <div class="flex flex-col md:flex-row items-start md:items-center gap-6 justify-between">
          <div class="bg-black border-2 border-white p-4 flex items-center justify-center">
            <img
              src={logoImage.src}
              alt="Partido Sintético Español Logo"
              width={256}
              height={128}
              class="h-16 sm:h-20 w-auto object-contain"
            />
          </div>
          <div class="space-y-2 font-mono text-xs text-zinc-300">
            <div><span class="text-[#ff2d2d] font-bold">ASSET_KEY</span>: tokens.assets.logo</div>
            <div><span class="text-[#ffe600] font-bold">SOURCE_PATH</span>: <code class="bg-black border border-zinc-700 px-2 py-0.5 text-white">apps/design-system-docs/sources/images/logo-256x128.png</code></div>
            <div><span class="text-[#00ff66] font-bold">DIMENSIONS</span>: 256x128px (2:1 aspect ratio)</div>
            <div><span class="text-zinc-400">FORMAT</span>: PNG with transparent / high-contrast channels</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Color Palette Swatches -->
    <section class="space-y-4">
      <h2 class="text-xl font-black uppercase text-white tracking-tight border-b-2 border-zinc-800 pb-2">
        // 02 · Color Tokens (Brutalist Strict Palette)
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {colorEntries.map(([key, hex]) => (
          <div class="bg-[#0d0d0d] border-2 border-zinc-800 p-4 space-y-3 hover:border-white transition-colors">
            <div class="h-16 border-2 border-zinc-700" style={`background-color: ${hex}`}></div>
            <div>
              <div class="font-mono text-xs font-bold uppercase text-white">{key}</div>
              <div class="font-mono text-xs text-zinc-400 uppercase">{hex}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Typography Scale -->
    <section class="space-y-4">
      <h2 class="text-xl font-black uppercase text-white tracking-tight border-b-2 border-zinc-800 pb-2">
        // 03 · Typography Scale (Space Grotesk & JetBrains Mono)
      </h2>
      <div class="bg-[#0d0d0d] border-2 border-zinc-800 divide-y-2 divide-zinc-800">
        {typographyEntries.map(([sizeKey, sizeVal]) => (
          <div class="p-4 flex flex-col md:flex-row md:items-center justify-between gap-2">
            <div class="w-36 flex-shrink-0">
              <span class="font-mono text-xs text-[#ff2d2d] font-bold uppercase">[ {sizeKey} ]</span>
              <span class="font-mono text-xs text-zinc-500 ml-2">({sizeVal})</span>
            </div>
            <div class="flex-grow font-heading font-bold text-white uppercase truncate" style={`font-size: ${sizeVal}`}>
              Partido Sintético Español — 2026
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Subtle Grid Background Pattern -->
    <section class="space-y-4">
      <h2 class="text-xl font-black uppercase text-white tracking-tight border-b-2 border-zinc-800 pb-2">
        // 04 · Background Pattern (Ultra-Subtle Technical Grid)
      </h2>
      <div class="bg-[#0d0d0d] border-2 border-zinc-800 p-6 space-y-4">
        <div
          class="h-32 w-full bg-black border-2 border-zinc-800 relative flex items-center justify-center font-mono text-xs text-zinc-400 uppercase font-bold"
          style="background-image: linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px); background-size: 32px 32px;"
        >
          <span>[ ULTRA-SUBTLE GRID PATTERN (2% CONTRAST) ]</span>
        </div>
        <p class="text-xs font-mono text-zinc-400 leading-relaxed">
          The grid pattern uses <code class="text-white">rgba(255,255,255,0.02)</code> with a <code class="text-white">32px × 32px</code> repeat. It provides technical texture while remaining virtually invisible on lower contrast screens.
        </p>
      </div>
    </section>

    <!-- Brutalist Hard Shadows -->
    <section class="space-y-4">
      <h2 class="text-xl font-black uppercase text-white tracking-tight border-b-2 border-zinc-800 pb-2">
        // 05 · Hard Offset Shadows
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-6">
        {shadowEntries.map(([key, val]) => (
          <div class="bg-[#0d0d0d] border-2 border-zinc-800 p-6 space-y-4">
            <div
              class="w-full h-16 bg-zinc-900 border-2 border-white flex items-center justify-center font-mono text-xs uppercase font-bold"
              style={`box-shadow: ${val}`}
            >
              {key}
            </div>
            <div class="font-mono text-xs">
              <span class="text-zinc-300 font-bold uppercase">{key}</span>
              <div class="text-zinc-500">{val}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Spacing Scale Grid -->
    <section class="space-y-4">
      <h2 class="text-xl font-black uppercase text-white tracking-tight border-b-2 border-zinc-800 pb-2">
        // 06 · Spacing Scale Tokens
      </h2>
      <div class="bg-[#0d0d0d] border-2 border-zinc-800 p-6 grid grid-cols-2 sm:grid-cols-4 gap-6">
        {spacingEntries.map(([key, val]) => (
          <div class="space-y-2">
            <div class="flex justify-between items-center text-xs font-mono">
              <span class="text-white font-bold">spacing.{key}</span>
              <span class="text-zinc-400">{val}</span>
            </div>
            <div class="bg-[#ff2d2d] h-4 border border-white" style={`width: ${val}`}></div>
          </div>
        ))}
      </div>
    </section>

    <!-- Radii Tokens (Strict Brutalism: 0px) -->
    <section class="space-y-4">
      <h2 class="text-xl font-black uppercase text-white tracking-tight border-b-2 border-zinc-800 pb-2">
        // 07 · Border Radius Tokens (Strict Brutalism: 0px)
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {radiiEntries.map(([key, val]) => (
          <div class="bg-[#0d0d0d] border-2 border-zinc-800 p-4 text-center space-y-3">
            <div class="w-14 h-14 bg-white mx-auto border-2 border-zinc-700" style={`border-radius: ${val}`}></div>
            <div>
              <div class="font-mono text-xs font-bold text-white uppercase">{key}</div>
              <div class="font-mono text-xs text-zinc-500">{val} (sharp)</div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</ShowcaseLayout>
