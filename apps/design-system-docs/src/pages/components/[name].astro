---
import ShowcaseLayout from '../../layouts/ShowcaseLayout.astro';
import { componentSpecs } from '@repo/design-system/specs';
import ArticleHeader from '@repo/design-system/components/ArticleHeader.astro';
import Badge from '@repo/design-system/components/Badge.astro';
import Button from '@repo/design-system/components/Button.astro';
import Callout from '@repo/design-system/components/Callout.astro';
import Card from '@repo/design-system/components/Card.astro';
import Divider from '@repo/design-system/components/Divider.astro';
import Footer from '@repo/design-system/components/Footer.astro';
import Header from '@repo/design-system/components/Header.astro';
import Hero from '@repo/design-system/components/Hero.astro';
import KeyFact from '@repo/design-system/components/KeyFact.astro';
import Lead from '@repo/design-system/components/Lead.astro';
import PullQuote from '@repo/design-system/components/PullQuote.astro';
import SectionTitle from '@repo/design-system/components/SectionTitle.astro';
import logo256Image from '../../../sources/images/logo-256x128.png';

export function getStaticPaths() {
  return [
    { params: { name: 'ArticleHeader' } },
    { params: { name: 'Badge' } },
    { params: { name: 'Button' } },
    { params: { name: 'Callout' } },
    { params: { name: 'Card' } },
    { params: { name: 'Divider' } },
    { params: { name: 'Footer' } },
    { params: { name: 'Header' } },
    { params: { name: 'Hero' } },
    { params: { name: 'KeyFact' } },
    { params: { name: 'Lead' } },
    { params: { name: 'Logo' } },
    { params: { name: 'PullQuote' } },
    { params: { name: 'SectionTitle' } },
  ];
}

const { name } = Astro.params;
const spec = componentSpecs[name];
---

<ShowcaseLayout title={`${name} Component Workbench`}>
  <div class="max-w-5xl space-y-12">
    <div class="flex items-center justify-between border-b-2 border-zinc-800 pb-6">
      <div>
        <div class="flex items-center space-x-3">
          <span class="px-2.5 py-0.5 text-xs font-mono font-bold text-[#00ff66] bg-black border border-[#00ff66] uppercase">
            {spec.category}
          </span>
          <h1 class="text-3xl sm:text-4xl font-black uppercase text-white font-mono">[ {name} ]</h1>
        </div>
        <p class="text-zinc-400 mt-2 text-sm font-sans">{spec.description}</p>
      </div>
      <a href="/" class="text-xs text-[#ff2d2d] hover:text-white font-mono font-bold uppercase tracking-wider">
        &larr; VOLVER A SPECS
      </a>
    </div>

    <!-- Live Component Preview Workbench -->
    <section class="space-y-4">
      <h2 class="text-xl font-black uppercase text-white tracking-tight border-b-2 border-zinc-800 pb-2">
        // 01 · Live Component Canvas
      </h2>
      <div class="bg-[#0d0d0d] border-2 border-zinc-800 p-8 min-h-[220px] flex items-center justify-center relative overflow-hidden">
        {name === 'Badge' && (
          <div class="flex flex-wrap gap-4 items-center justify-center">
            <Badge text="Principios" variant="accent" />
            <Badge text="Gobernanza" variant="neutral" />
            <Badge text="Participación" variant="outline" />
          </div>
        )}

        {name === 'ArticleHeader' && (
          <div class="w-full max-w-3xl">
            <ArticleHeader
              kicker="Principios"
              title="Doce principios para una democracia evaluable"
              description="Entradilla de ejemplo: cómo el partido traduce la evidencia en decisiones políticas auditables."
              tag="Gobernanza"
              author="Partido Sintético Español"
              date="24 de agosto de 2026"
            />
          </div>
        )}

        {name === 'Lead' && (
          <div class="w-full max-w-3xl">
            <Lead>Primer párrafo destacado del artículo, ligeramente mayor que el texto de cuerpo para guiar la lectura.</Lead>
          </div>
        )}

        {name === 'SectionTitle' && (
          <div class="w-full max-w-3xl space-y-8">
            <SectionTitle kicker="Gobernanza" title="La evidencia como base de la democracia" />
            <SectionTitle as="h3" title="Subsección: simulación de políticas públicas" />
          </div>
        )}

        {name === 'PullQuote' && (
          <div class="w-full max-w-3xl">
            <PullQuote
              quote="La IA no gobernará. La IA informará, simulará y auditará."
              author="Principios fundacionales"
            />
          </div>
        )}

        {name === 'Callout' && (
          <div class="w-full max-w-3xl space-y-4">
            <Callout variant="info">Nota de contexto con borde blanco para información complementaria.</Callout>
            <Callout variant="success" title="Resultado">Medición de ejemplo: el impacto de la propuesta tras su evaluación.</Callout>
            <Callout variant="warning">Aviso de limitación o incertidumbre del análisis.</Callout>
          </div>
        )}

        {name === 'KeyFact' && (
          <div class="w-full flex justify-center">
            <KeyFact
              value="12"
              label="principios fundacionales"
              caption="Cada propuesta se evalúa por beneficiarios, coste e incertidumbre."
            />
          </div>
        )}

        {name === 'Divider' && (
          <div class="w-full max-w-3xl">
            <Divider label="Siguiente sección" />
            <Divider />
          </div>
        )}

        {name === 'Button' && (
          <div class="flex flex-wrap gap-4 items-center justify-center">
            <Button variant="primary">Primary Button</Button>
            <Button variant="secondary">Secondary Button</Button>
            <Button variant="outline">Outline Button</Button>
            <Button variant="primary" size="sm">Small</Button>
            <Button variant="primary" size="lg">Large</Button>
          </div>
        )}

        {name === 'Card' && (
          <div class="w-full max-w-md">
            <Card
              title="Gobernanza Sintética"
              subtitle="Ejemplo de tarjeta preview visual aislada."
              tag="Component Spec"
              href="#"
            >
              <p class="text-xs text-zinc-500 font-mono mt-2">// RENDERIZADO AISLADO PUERTO 4322</p>
            </Card>
          </div>
        )}

        {name === 'Hero' && (
          <div class="w-full">
            <Hero
              title="Democracia Sintética e Inteligencia Colectiva"
              description="Visualización del componente Hero en el workbench aislado."
              ctaText="Explorar Componente"
              ctaHref="#"
            />
          </div>
        )}

        {name === 'Logo' && (
          <div class="flex flex-col items-center justify-center p-8 bg-black border-2 border-white space-y-4">
            <img
              src={logo256Image.src}
              alt="Partido Sintético Español Logo"
              width={256}
              height={128}
              class="h-20 w-auto object-contain"
            />
            <div class="font-mono text-xs text-zinc-400 uppercase tracking-wider">
              [ SOURCE: apps/design-system-docs/sources/images/logo-256x128.png ]
            </div>
          </div>
        )}

        {name === 'Header' && (
          <div class="w-full">
            <Header
              siteTitle="Partido Sintético Español (Showcase Preview)"
              logoSrc={logo256Image.src}
              navItems={[
                { label: 'Inicio', href: '#' },
                { label: 'Propuestas', href: '#' },
              ]}
            />
          </div>
        )}

        {name === 'Footer' && (
          <div class="w-full">
            <Footer copyright="© 2026 Partido Sintético Español • Component Visual Preview" />
          </div>
        )}
      </div>
    </section>

    <!-- Visual Specifications Table -->
    <section class="space-y-4">
      <h2 class="text-xl font-black uppercase text-white tracking-tight border-b-2 border-zinc-800 pb-2">
        // 02 · Variant Specifications
      </h2>
      <div class="bg-[#0d0d0d] border-2 border-zinc-800 divide-y-2 divide-zinc-800">
        {Object.entries(spec.variants).map(([vName, vSpec]) => (
          <div class="p-6 space-y-3">
            <div class="flex items-center space-x-3">
              <span class="font-mono text-xs font-bold text-black bg-[#ff2d2d] px-2 py-0.5 uppercase">
                {vName}
              </span>
              <span class="text-sm text-zinc-300 font-sans">{vSpec.description}</span>
            </div>
            <div class="bg-black p-4 border border-zinc-800 font-mono text-xs text-zinc-400 space-y-1">
              {Object.entries(vSpec.tokenUsage).map(([tokenKey, tokenVal]) => (
                <div><span class="text-[#ffe600]">{tokenKey}</span>: <span class="text-[#00ff66]">{tokenVal}</span></div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Accessibility Notes if present -->
    {spec.accessibilityNotes && (
      <section class="space-y-4">
        <h2 class="text-xl font-black uppercase text-white tracking-tight border-b-2 border-zinc-800 pb-2">
          // 03 · Accessibility (a11y) Notes
        </h2>
        <ul class="bg-[#0d0d0d] border-2 border-zinc-800 p-6 space-y-2 list-disc list-inside text-xs font-mono text-zinc-300">
          {spec.accessibilityNotes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
      </section>
    )}
  </div>
</ShowcaseLayout>
