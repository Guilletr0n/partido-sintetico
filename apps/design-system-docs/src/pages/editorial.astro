---
import ShowcaseLayout from '../layouts/ShowcaseLayout.astro';
import ArticleHeader from '@repo/design-system/components/ArticleHeader.astro';
import Badge from '@repo/design-system/components/Badge.astro';
import Callout from '@repo/design-system/components/Callout.astro';
import Divider from '@repo/design-system/components/Divider.astro';
import KeyFact from '@repo/design-system/components/KeyFact.astro';
import Lead from '@repo/design-system/components/Lead.astro';
import PullQuote from '@repo/design-system/components/PullQuote.astro';
import SectionTitle from '@repo/design-system/components/SectionTitle.astro';

const editorialComponents = [
  {
    name: 'ArticleHeader',
    category: 'organism',
    description: 'Composición de cabecera de artículo: kicker monospace, título masivo (H1), entradilla y barra de metadatos.',
    props: ['title', 'kicker', 'description', 'tag', 'author', 'date'],
  },
  {
    name: 'Badge',
    category: 'atom',
    description: 'Etiqueta técnica monospace con borde sólido y 0px radio. Variantes: accent, neutral, outline.',
    props: ['text', 'variant'],
  },
  {
    name: 'Lead',
    category: 'atom',
    description: 'Primer párrafo del artículo, tipografía en alto contraste para guiar la lectura.',
    props: ['slot', 'className'],
  },
  {
    name: 'SectionTitle',
    category: 'molecule',
    description: 'Título editorial en Grotesk con kicker monospace, ancla (id) y alineación.',
    props: ['title', 'kicker', 'as', 'id', 'align'],
  },
  {
    name: 'PullQuote',
    category: 'molecule',
    description: 'Cita destacada con barra sólida de 8px y atribución técnica monospace.',
    props: ['quote', 'author', 'variant'],
  },
  {
    name: 'Callout',
    category: 'molecule',
    description: 'Bloque de nota editorial con borde sólido de 2px y etiqueta superior. Variantes: info, success, warning.',
    props: ['variant', 'title', 'slot'],
  },
  {
    name: 'KeyFact',
    category: 'molecule',
    description: 'Dato destacado con valor monospace gigante, etiqueta y pie para artículos basados en evidencia.',
    props: ['value', 'label', 'caption'],
  },
  {
    name: 'Divider',
    category: 'atom',
    description: 'Separador temático de artículo con etiqueta técnica centrada opcional.',
    props: ['label'],
  },
];
---

<ShowcaseLayout title="Editorial Elements">
  <div class="max-w-5xl space-y-12">
    <!-- Page header -->
    <div class="border-b-2 border-zinc-800 pb-6">
      <div class="flex items-center space-x-2 mb-2">
        <span class="w-3 h-3 bg-[#00ff66]"></span>
        <span class="font-mono text-xs font-bold text-[#00ff66] uppercase tracking-widest">// COMPONENTES EDITORIALES</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-black uppercase text-white tracking-tight">Editorial Elements & Compositions</h1>
      <p class="text-zinc-400 mt-2 max-w-2xl text-sm font-sans">
        Elementos editoriales de estética brutalista para enriquecer los artículos y manifiestos del Partido Sintético Español.
      </p>
    </div>

    <!-- Element catalog -->
    <section class="space-y-6">
      <h2 class="text-xl font-black uppercase text-white tracking-tight border-b-2 border-zinc-800 pb-2">
        // 01 · Catálogo de Elementos
      </h2>
      {editorialComponents.map((comp) => (
        <div class="bg-[#0d0d0d] border-2 border-zinc-800">
          <div class="px-6 py-4 border-b-2 border-zinc-800 flex flex-wrap items-center justify-between gap-2 bg-black">
            <div class="flex items-center space-x-3">
              <span class="font-mono text-sm font-bold text-white uppercase">[ {comp.name} ]</span>
              <span class="text-xs font-mono font-bold text-[#00ff66] bg-black border border-[#00ff66] px-2 py-0.5 uppercase tracking-wider">{comp.category}</span>
            </div>
            <span class="text-xs text-zinc-500 font-mono">{comp.props.join(' · ')}</span>
          </div>
          <div class="px-6 py-3 border-b-2 border-zinc-800/60 text-xs font-mono text-zinc-400 bg-zinc-950">{comp.description}</div>
          <div class="bg-black p-8 min-h-[140px] flex items-center justify-center relative overflow-hidden">
            {comp.name === 'Badge' && (
              <div class="flex flex-wrap gap-4 items-center justify-center">
                <Badge text="Principios" variant="accent" />
                <Badge text="Gobernanza" variant="neutral" />
                <Badge text="Participación" variant="outline" />
              </div>
            )}
            {comp.name === 'ArticleHeader' && (
              <div class="w-full max-w-3xl">
                <ArticleHeader
                  kicker="Principios"
                  title="Doce principios para una democracia evaluable"
                  description="Entradilla de ejemplo: cómo el partido traduce la evidencia en decisiones políticas auditables."
                  tag="Gobernanza"
                  author="Partido Sintético Español"
                  date="24 de agosto de 2026"
                />
              </div>
            )}
            {comp.name === 'Lead' && (
              <div class="w-full max-w-3xl">
                <Lead>Primer párrafo destacado del artículo, ligeramente mayor que el texto de cuerpo para guiar la lectura.</Lead>
              </div>
            )}
            {comp.name === 'SectionTitle' && (
              <div class="w-full max-w-3xl space-y-8">
                <SectionTitle kicker="Gobernanza" title="La evidencia como base de la democracia" />
                <SectionTitle as="h3" title="Subsección: simulación de políticas públicas" />
              </div>
            )}
            {comp.name === 'PullQuote' && (
              <div class="w-full max-w-3xl">
                <PullQuote
                  quote="La IA no gobernará. La IA informará, simulará y auditará."
                  author="Principios fundacionales"
                />
              </div>
            )}
            {comp.name === 'Callout' && (
              <div class="w-full max-w-3xl space-y-4">
                <Callout variant="info">Nota de contexto con borde blanco para información complementaria.</Callout>
                <Callout variant="success" title="Resultado">Medición de ejemplo: el impacto de la propuesta tras su evaluación.</Callout>
                <Callout variant="warning">Aviso de limitación o incertidumbre del análisis.</Callout>
              </div>
            )}
            {comp.name === 'KeyFact' && (
              <div class="w-full flex justify-center">
                <KeyFact
                  value="12"
                  label="principios fundacionales"
                  caption="Cada propuesta se evalúa por beneficiarios, coste e incertidumbre."
                />
              </div>
            )}
            {comp.name === 'Divider' && (
              <div class="w-full max-w-3xl">
                <Divider label="Siguiente sección" />
                <Divider />
              </div>
            )}
          </div>
        </div>
      ))}
    </section>

    <!-- Composition: full article mockup -->
    <section class="space-y-4">
      <div class="flex items-center space-x-3 border-b-2 border-zinc-800 pb-2">
        <h2 class="text-xl font-black uppercase text-white tracking-tight">// 02 · Composición de Artículo Completo</h2>
        <span class="text-xs font-mono font-bold text-black bg-[#ff2d2d] px-2 py-0.5 uppercase">MOCKUP</span>
      </div>
      <div class="bg-[#0d0d0d] border-2 border-zinc-800">
        <div class="px-6 py-3 border-b-2 border-zinc-800 text-xs text-zinc-400 font-mono uppercase tracking-wider bg-black">
          EJEMPLO DE ARTÍCULO · DEMOSTRACIÓN EDITORIAL BRUTALISTA
        </div>
        <article class="p-8 sm:p-12 max-w-3xl mx-auto space-y-6 font-sans">
          <ArticleHeader
            kicker="Principios"
            title="Doce principios para una democracia evaluable"
            description="El Partido Sintético Español define su política como hipótesis contrastables: la IA informa, simula y audita; la ciudadanía decide."
            tag="Gobernanza"
            author="Partido Sintético Español"
            date="24 de agosto de 2026"
          />

          <Divider />

          <Lead>
            Cada propuesta relevante deberá poder ser evaluada respecto de sus beneficiarios, su coste, sus efectos
            a corto y largo plazo y la incertidumbre del análisis.
          </Lead>

          <SectionTitle kicker="Método" title="La evidencia como infraestructura democrática" id="evidencia" />
          <p class="text-zinc-200 leading-relaxed text-base">
            El partido no adoptará una doctrina económica cerrada. La pregunta fundamental será qué política consigue
            mejor el objetivo que queremos alcanzar, con qué coste y para quién.
          </p>

          <div class="my-8 flex justify-center">
            <KeyFact
              value="12"
              label="principios fundacionales"
              caption="Cada propuesta se evalúa por beneficiarios, coste e incertidumbre."
            />
          </div>

          <PullQuote
            quote="La IA no gobernará. La IA informará, simulará y auditará."
            author="Principios fundacionales"
          />

          <SectionTitle as="h3" title="Límites del sistema" id="limites" />
          <p class="text-zinc-200 leading-relaxed text-base">
            La eficiencia nunca será una justificación suficiente para eliminar un derecho fundamental.
          </p>

          <div class="my-8 space-y-4">
            <Callout variant="info" title="En qué consiste">
              La transparencia no será una herramienta de comunicación. Será una limitación deliberada del poder.
            </Callout>
            <Callout variant="warning">
              Los modelos tienen incertidumbre; los análisis deben informar de ella explícitamente.
            </Callout>
            <Callout variant="success" title="Resultado esperado">
              Decisiones evaluables, cargos temporales y un partido diseñado para poder desaparecer.
            </Callout>
          </div>

          <Divider label="Siguiente sección" />
          <p class="text-zinc-400 font-mono text-xs uppercase">
            // FIN DE COMPOSICIÓN EDITORIAL DE DEMOSTRACIÓN.
          </p>
        </article>
      </div>
    </section>
  </div>
</ShowcaseLayout>
