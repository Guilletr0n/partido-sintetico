---
import logoImage from '../../sources/images/logo-256x128.png';
export interface Props {
  title: string;
}

const { title } = Astro.props;

const sidebarLinks = [
  { label: 'Overview & Specs', href: '/' },
  { label: 'Design Tokens', href: '/tokens' },
  { label: 'Logo', href: '/components/Logo' },
  { label: 'Button', href: '/components/Button' },
  { label: 'Card', href: '/components/Card' },
  { label: 'Hero', href: '/components/Hero' },
  { label: 'Header', href: '/components/Header' },
  { label: 'Footer', href: '/components/Footer' },
];

const editorialLinks = [{ label: 'Editorial Elements', href: '/editorial' }];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Design System Showcase</title>

    <!-- Google Fonts for Brutalist Web Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;700;800&family=Space+Grotesk:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-black text-white min-h-screen flex flex-col font-sans antialiased selection:bg-[#ffe600] selection:text-black">
    <!-- Top Header Bar -->
    <header class="bg-black border-b-2 px-6 py-3 flex items-center justify-between sticky top-0 z-50">
      <div class="flex items-center space-x-4">
        <a href="/" class="flex items-center space-x-3">
          <img
            src={logoImage.src}
            alt="PSE Logo"
            width={64}
            height={32}
            class="h-8 w-auto object-contain border bg-black p-0.5"
          />
          <span class="px-2 py-0.5 bg-[#ff2d2d] text-black font-mono font-black text-xs uppercase tracking-wider border border-white">
            [ WORKBENCH ]
          </span>
        </a>
        <h1 class="text-base font-black uppercase text-white tracking-tight hidden sm:block">Design System Showcase</h1>
      </div>
      <div class="text-xs font-mono text-zinc-400 bg-zinc-900 px-3 py-1.5 border border-zinc-700">
        PORT 4322 • ISOLATED UI (CMS PORT 4321)
      </div>
    </header>

    <div class="flex-grow flex">
      <!-- Sidebar Navigation -->
      <aside class="w-64 bg-[#0a0a0a] border-r-2 border-zinc-800 p-6 flex flex-col space-y-6 flex-shrink-0">
        <div>
          <h2 class="text-xs font-mono font-bold text-[#ff2d2d] uppercase tracking-wider mb-3">// SPECS & TOKENS</h2>
          <ul class="space-y-1">
            {sidebarLinks.slice(0, 2).map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block px-3 py-2 text-xs font-mono uppercase font-bold text-zinc-300 hover:text-white hover:bg-zinc-900 border border-transparent hover:border-zinc-700 transition-colors"
                >
                  [ {link.label} ]
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="text-xs font-mono font-bold text-[#00ff66] uppercase tracking-wider mb-3">// EDITORIAL</h2>
          <ul class="space-y-1">
            {editorialLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block px-3 py-2 text-xs font-mono uppercase font-bold text-zinc-300 hover:text-white hover:bg-zinc-900 border border-transparent hover:border-zinc-700 transition-colors"
                >
                  [ {link.label} ]
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="text-xs font-mono font-bold text-[#ffe600] uppercase tracking-wider mb-3">// UI COMPONENTS</h2>
          <ul class="space-y-1">
            {sidebarLinks.slice(2).map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block px-3 py-2 text-xs font-mono uppercase font-bold text-zinc-300 hover:text-white hover:bg-zinc-900 border border-transparent hover:border-zinc-700 transition-colors"
                >
                  [ {link.label} ]
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>

      <!-- Main Workbench Content -->
      <main class="flex-grow p-8 sm:p-12 bg-black overflow-y-auto">
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --font-sans: 'Space Grotesk', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
    --font-serif: 'Instrument Serif', Georgia, serif;
  }
  body {
    font-family: var(--font-sans);
    background-color: #000000;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: center center;
  }
  code, pre, .font-mono {
    font-family: var(--font-mono);
  }
</style>
