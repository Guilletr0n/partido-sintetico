---
export interface Props {
  title: string;
}

const { title } = Astro.props;

const sidebarLinks = [
  { label: 'Overview & Specs', href: '/' },
  { label: 'Design Tokens', href: '/tokens' },
  { label: 'Button', href: '/components/Button' },
  { label: 'Card', href: '/components/Card' },
  { label: 'Hero', href: '/components/Hero' },
  { label: 'Header', href: '/components/Header' },
  { label: 'Footer', href: '/components/Footer' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Design System Showcase</title>
  </head>
  <body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col font-sans antialiased">
    <!-- Top Header Bar -->
    <header class="bg-slate-950 border-b border-slate-800 px-6 py-4 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <span class="px-2.5 py-1 bg-blue-600 text-white font-bold text-xs rounded-md uppercase tracking-wider">
          Isolated UI
        </span>
        <h1 class="text-lg font-bold text-white tracking-tight">Design System Showcase & Workbench</h1>
      </div>
      <div class="text-xs text-slate-400 bg-slate-800/80 px-3 py-1.5 rounded-full border border-slate-700">
        Port 4322 • Isolated from Main CMS UI (Port 4321)
      </div>
    </header>

    <div class="flex-grow flex">
      <!-- Sidebar Navigation -->
      <aside class="w-64 bg-slate-950/60 border-r border-slate-800 p-6 flex flex-col space-y-6">
        <div>
          <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">System Specs</h2>
          <ul class="space-y-1">
            {sidebarLinks.slice(0, 2).map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block px-3 py-2 text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/60 rounded-md transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">UI Components</h2>
          <ul class="space-y-1">
            {sidebarLinks.slice(2).map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block px-3 py-2 text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/60 rounded-md transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>

      <!-- Main Workbench Content -->
      <main class="flex-grow p-8 bg-slate-900 overflow-y-auto">
        <slot />
      </main>
    </div>
  </body>
</html>
