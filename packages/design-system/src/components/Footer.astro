---
export interface Props {
  copyright?: string;
}

const { copyright = `© ${new Date().getFullYear()} Partido Sintético Español. All rights reserved.` } = Astro.props;
---

<footer class="bg-slate-950 text-slate-400 py-8 border-t border-slate-900 mt-auto">
  <div class="max-w-7xl mx-auto px-4 text-center text-sm">
    <p>{copyright}</p>
  </div>
</footer>
