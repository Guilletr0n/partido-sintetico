---
export interface Props {
  copyright?: string;
}

const { copyright = `© ${new Date().getFullYear()} Partido Sintético Español. Plataforma Abierta de Inteligencia Colectiva.` } = Astro.props;
---

<footer class="bg-black text-zinc-400 py-12 border-t-2 border-zinc-800 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-mono">
    <div class="flex items-center space-x-2">
      <span class="inline-block w-2 h-2 bg-[#00ff66]"></span>
      <span class="text-white font-bold uppercase">PSE // DEMOCRACIA EVALUABLE</span>
    </div>
    <p class="text-zinc-500 uppercase tracking-wider text-center md:text-right">{copyright}</p>
  </div>
</footer>
