---
import Badge from './Badge.astro';
import Lead from './Lead.astro';

/**
 * ArticleHeader — brutalist editorial composition for the top of an article:
 * kicker badge, title (H1), lead description and meta line (tag, author, date).
 * @prop {string} title - Article title (H1).
 * @prop {string} [kicker] - Short eyebrow label above the title.
 * @prop {string} [description] - Lead paragraph below the title.
 * @prop {string} [tag] - Category tag shown in the meta line.
 * @prop {string} [author] - Author name shown in the meta line.
 * @prop {string} [date] - Publication date shown in the meta line.
 */
export interface Props {
  title: string;
  kicker?: string;
  description?: string;
  tag?: string;
  author?: string;
  date?: string;
}

const { title, kicker, description, tag, author, date } = Astro.props;
const hasMeta = Boolean(tag || author || date);
---

<header class="max-w-4xl mx-auto space-y-6">
  {kicker && (
    <div class="flex items-center space-x-3">
      <span class="inline-block w-3 h-3 bg-[#ff2d2d]"></span>
      <Badge text={kicker} variant="accent" />
    </div>
  )}

  <h1 class="text-3xl sm:text-5xl md:text-6xl font-black uppercase tracking-tight text-white leading-[1.02] text-balance">
    {title}
  </h1>

  {description && <Lead>{description}</Lead>}

  {hasMeta && (
    <div class="border-y-2 border-zinc-800 py-3 flex items-center justify-between gap-4 flex-wrap text-xs font-mono text-zinc-400 uppercase">
      <div class="flex items-center gap-3">
        {tag && <Badge text={tag} variant="neutral" />}
        {author && (
          <span>
            AUTOR: <strong class="text-white font-bold">{author}</strong>
          </span>
        )}
      </div>
      {date && (
        <div class="text-zinc-500 font-mono">
          FECHA: <span class="text-zinc-300">{date}</span>
        </div>
      )}
    </div>
  )}
</header>
