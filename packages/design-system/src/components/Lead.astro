---
/**
 * Lead — first (lead) paragraph of an article, high contrast display size.
 * @prop {string} [className] - Extra utility classes appended to the paragraph.
 */
export interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<p class={`text-xl sm:text-2xl text-white font-medium leading-relaxed tracking-tight font-sans ${className}`}>
  <slot />
</p>
