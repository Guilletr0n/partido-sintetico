---
export interface Props {
  title?: string;
  subtitle?: string;
  href?: string;
  tag?: string;
}

const { title, subtitle, href, tag } = Astro.props;
---

<div class="bg-zinc-900/80 border border-zinc-800 rounded-xl p-6 flex flex-col justify-between hover:border-zinc-700 hover:shadow-lg hover:shadow-emerald-950/20 transition-all group">
  <div>
    {tag && (
      <span class="inline-block px-2.5 py-0.5 mb-3 text-xs font-semibold text-emerald-400 bg-emerald-950/60 border border-emerald-800/60 rounded-full">
        {tag}
      </span>
    )}
    {title && (
      <h3 class="text-xl font-bold text-zinc-100 group-hover:text-emerald-400 transition-colors mb-2">
        {href ? <a href={href} class="hover:underline">{title}</a> : title}
      </h3>
    )}
    {subtitle && <p class="text-zinc-400 text-sm mb-4 leading-relaxed">{subtitle}</p>}
    <slot />
  </div>
  {href && (
    <div class="mt-6 pt-4 border-t border-zinc-800/80 flex justify-end">
      <a href={href} class="text-xs font-semibold text-emerald-400 group-hover:text-emerald-300 flex items-center space-x-1">
        <span>Read more</span>
        <span>&rarr;</span>
      </a>
    </div>
  )}
</div>
