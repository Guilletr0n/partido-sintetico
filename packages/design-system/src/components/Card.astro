---
export interface Props {
  title?: string;
  subtitle?: string;
  href?: string;
  tag?: string;
}

const { title, subtitle, href, tag } = Astro.props;
---

<div class="bg-[#0d0d0d] border-2 border-zinc-800 rounded-none p-6 flex flex-col justify-between hover:border-white hover:shadow-[4px_4px_0px_0px_#ff2d2d] transition-all duration-150 group">
  <div>
    {tag && (
      <div class="mb-4">
        <span class="inline-block px-2 py-0.5 text-xs font-mono font-bold uppercase tracking-wider text-[#ff2d2d] bg-[#ff2d2d]/10 border border-[#ff2d2d]">
          [ {tag} ]
        </span>
      </div>
    )}
    {title && (
      <h3 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-white group-hover:text-[#ff2d2d] transition-colors mb-3">
        {href ? <a href={href} class="hover:underline">{title}</a> : title}
      </h3>
    )}
    {subtitle && <p class="text-zinc-300 text-sm mb-4 leading-relaxed font-sans">{subtitle}</p>}
    <slot />
  </div>
  {href && (
    <div class="mt-6 pt-4 border-t-2 border-zinc-900 flex justify-between items-center">
      <span class="font-mono text-xs text-zinc-500 uppercase">// ENLACE</span>
      <a href={href} class="text-xs font-mono font-bold uppercase text-[#ff2d2d] group-hover:text-white flex items-center space-x-1 tracking-wider">
        <span>LEER MÁS</span>
        <span>&rarr;</span>
      </a>
    </div>
  )}
</div>
