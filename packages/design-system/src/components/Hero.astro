---
import Button from './Button.astro';

export interface Props {
  title: string;
  description: string;
  ctaText?: string;
  ctaHref?: string;
  badgeText?: string;
}

const { title, description, ctaText = 'EXPLORAR', ctaHref = '#', badgeText = 'SISTEMA ACTIVO // PSE-2026' } = Astro.props;
---

<section class="relative bg-black text-white py-20 sm:py-28 px-4 sm:px-6 border-b-4 border-white overflow-hidden">
  <!-- Subtle Brutalist Grid Background overlay -->
  <div class="absolute inset-0 opacity-15 pointer-events-none bg-[linear-gradient(to_right,#27272a_1px,transparent_1px),linear-gradient(to_bottom,#27272a_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>

  <div class="relative max-w-5xl mx-auto space-y-8">
    {badgeText && (
      <div class="inline-flex items-center space-x-2 bg-black border-2 border-zinc-700 px-4 py-1.5 text-xs font-mono font-bold uppercase tracking-widest text-[#00ff66]">
        <span class="w-2.5 h-2.5 bg-[#00ff66] animate-pulse"></span>
        <span>[ {badgeText} ]</span>
      </div>
    )}

    <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tighter text-white uppercase leading-[0.95] text-balance">
      {title}
    </h1>

    <div class="w-24 h-1.5 bg-[#ff2d2d]"></div>

    <p class="text-lg sm:text-2xl text-zinc-300 max-w-3xl leading-relaxed font-sans">
      {description}
    </p>

    {ctaText && (
      <div class="pt-6 flex flex-wrap gap-4 items-center">
        <Button href={ctaHref} variant="primary" size="lg">
          {ctaText} &rarr;
        </Button>
        <Button href="#propuestas" variant="outline" size="lg">
          DOCUMENTACIÓN
        </Button>
      </div>
    )}
  </div>
</section>
