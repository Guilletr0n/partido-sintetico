---
export interface Props {
  siteTitle?: string;
  logoSrc?: string;
  navItems?: Array<{ label: string; href: string }>;
}

const { siteTitle = 'Partido Sintético Español', logoSrc, navItems = [] } = Astro.props;
---

<header class="bg-black sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      {logoSrc ? (
        <img src={logoSrc} alt={`${siteTitle} Logo`} class="h-8 w-auto object-contain" />
      ) : (
        <div class="w-8 h-8 rounded-none bg-[#ff2d2d] text-black flex items-center justify-center font-mono font-black text-xs border border-white">
          PSE
        </div>
      )}
      <a href="/" class="text-base sm:text-lg font-black tracking-tighter uppercase text-white hover:text-[#ff2d2d] transition-colors">
        {siteTitle}
      </a>
    </div>
    <nav class="flex space-x-4 sm:space-x-8 items-center">
      {navItems.map((item) => (
        <a href={item.href} class="text-xs font-mono font-bold uppercase tracking-wider text-zinc-400 hover:text-[#ff2d2d] transition-colors">
          [ {item.label} ]
        </a>
      ))}
    </nav>
  </div>
</header>
